{
  "name": "seton",
  "productName": "Seton",
  "private": true,
  "version": "0.1.0",
  "main": "desktop/main.js",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "app": "npm run build -w client && electron .",
    "dist": "npm run build -w client && electron-builder --mac"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chandanagarwal.seton",
    "productName": "Seton",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server/**/*.js",
      "server/package.json",
      "client/dist/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
